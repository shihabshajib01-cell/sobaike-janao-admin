# Sobai Ke Janao Admin Panel Environment Configuration

# API Base URL (Optional - fallback/mock services used when empty or unreachable)
VITE_API_BASE_URL=

# Application Environment Mode (development | production)
VITE_APP_ENV=development

# Base Routing Path (e.g., "/admin-sobaike-janao/" for GitHub Pages, or "/" for root domain)
VITE_BASE_PATH=/admin-sobaike-janao/
